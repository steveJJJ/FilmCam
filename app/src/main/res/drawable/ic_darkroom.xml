<?xml version="1.0" encoding="utf-8"?>
<!-- 暗房：放大机（灯室 + 支柱 + 光锥 + 压纸板相纸 + 底板）+ 红色安全灯。
     线稿风格与机身的银色金属一致，光锥/安全灯用暗房琥珀红点缀。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 投影光锥：从机头到相纸，暗房琥珀色微光 -->
    <path
        android:pathData="M12.8,15.5 L17.2,15.5 L21.8,34.5 L8.2,34.5 Z"
        android:fillColor="#2ED98E4A" />

    <!-- 支柱 -->
    <path
        android:pathData="M15,11 L15,39.5"
        android:strokeColor="#C9C5BC"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- 灯室（机头） -->
    <path
        android:pathData="M10.5,7.5 h9 a2.5,2.5 0 0 1 2.5,2.5 v3 a2.5,2.5 0 0 1 -2.5,2.5 h-9 a2.5,2.5 0 0 1 -2.5,-2.5 v-3 a2.5,2.5 0 0 1 2.5,-2.5 z"
        android:fillColor="#C9C5BC" />

    <!-- 压纸板上的相纸 -->
    <path
        android:pathData="M6,34.5 h17 v3.5 h-17 z"
        android:strokeColor="#C9C5BC"
        android:strokeWidth="2"
        android:strokeLineJoin="round" />

    <!-- 底板 -->
    <path
        android:pathData="M3.5,41.5 H33"
        android:strokeColor="#C9C5BC"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- 安全灯光晕 -->
    <path
        android:pathData="M39.5,10.5 m-5.2,0 a5.2,5.2 0 1 1 10.4,0 a5.2,5.2 0 1 1 -10.4,0"
        android:strokeColor="#40E14B3B"
        android:strokeWidth="1.6" />

    <!-- 安全灯 -->
    <path
        android:pathData="M39.5,10.5 m-2.8,0 a2.8,2.8 0 1 1 5.6,0 a2.8,2.8 0 1 1 -5.6,0"
        android:fillColor="#E14B3B" />
</vector>
