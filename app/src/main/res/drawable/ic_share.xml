    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
      ⚠️ strokeColor / strokeWidth / fillColor 只在 <path> 上生效，写在 <vector> 根上
      会被 VectorDrawable 忽略（vc100 真机：圆钮在、图标一个像素都没有）。
      写法与项目里可正常显示的 ic_feedback_mail.xml 一致：每条 path 自带描边。
    -->
    <!-- 托盘：箭头从里面向上指出 -->
