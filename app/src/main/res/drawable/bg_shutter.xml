<?xml version="1.0" encoding="utf-8"?>
<!-- 快门钮：哑光黑盘面 + 极克制的抛光外圈（黑色 T3 实机按键的观感）
     外圈只用一条自上而下的暗钛灰渐变做出「金属倒角」，顶部留一点弱反光，
     其余几乎不反光；盘面是纯哑光黑，不带任何高光。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 外圈（抛光倒角）：顶部微亮 → 迅速收暗 → 底部一线极弱的反射 -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#74787F"
                android:centerColor="#2C3036"
                android:centerY="0.18"
                android:endColor="#565A61" />
        </shape>
    </item>

    <!-- 哑光黑盘面：内缩露出外圈，边缘一道近黑细线把盘面与外圈分开 -->
    <item
        android:left="4.5dp"
        android:top="4.5dp"
        android:right="4.5dp"
        android:bottom="4.5dp">
        <shape android:shape="oval">
            <solid android:color="#24262A" />
            <stroke
                android:width="0.6dp"
                android:color="#0E1013" />
        </shape>
    </item>
</layer-list>
