    <string name="app_name">FilmCam</string>

    <!-- 关于页 -->
    <string name="about_intro">把手机变成一台康泰时 T3。\n\n取景器里看到的是真实的光学世界；快门按下一卷 36 张的胶卷；拍完送进暗房冲洗，出片由胶片引擎按这一卷的配方显影。\n\n冲洗之前，谁也不知道拍到的是什么——这就是胶片的乐趣。</string>
    <string name="percent_fmt">%1$d%%</string>
    <string name="about_self_title">FILMCAM 以 GNU GPL-3.0-or-later 开源分发</string>
    <string name="about_self_body">本项目使用了 GPL-3.0 的 SpektraLab 胶片模拟引擎，因而同样以 GPL-3.0-or-later 分发：你可以自由使用、修改与再分发，再分发时须开放源码并保留同一许可与署名。\n源码仓库尚未公开，依据许可条款，源码在索取时提供。</string>
