<resources>
    <style name="Theme.FilmCam" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- 成片信息面板：分组标题 -->
    <style name="InfoGroupTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:textColor">#8B1A1A</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- 成片信息面板：信息行 -->
    <style name="InfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">#E8D5C8</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
</resources>
