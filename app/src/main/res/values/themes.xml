<resources>
    <style name="Theme.FilmCam" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- 全 App 统一深色弹窗：暗房面板语义（深底 + 琥珀强调） -->
    <style name="DarkDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">#141416</item>
        <item name="android:colorBackground">#141416</item>
        <item name="colorPrimary">#FFC100</item>
        <item name="colorOnSurface">#E8E4DA</item>
        <item name="colorOnSurfaceVariant">#9A9A9E</item>
    </style>

    <!-- 钛银机身下的弹窗：面板跟着机身走，钛面 + 蚀刻深字（真机机身上的字是凹刻的深色） -->
    <style name="TitanDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">#C3C7CC</item>
        <item name="android:colorBackground">#C3C7CC</item>
        <item name="colorPrimary">#8B1A1A</item>
        <item name="colorOnSurface">#2E3136</item>
        <item name="colorOnSurfaceVariant">#5C6066</item>
    </style>

    <!-- 成片信息面板：分组标题 -->
    <style name="InfoGroupTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:textColor">#8B1A1A</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- 成片信息面板：信息行 -->
    <style name="InfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">#E8D5C8</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
</resources>
