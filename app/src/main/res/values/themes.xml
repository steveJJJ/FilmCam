<resources>
    <style name="Theme.FilmCam" parent="Theme.MaterialComponents.NoActionBar">
        <!-- v57：android:statusBarColor / android:navigationBarColor 在 Android 15
             (API 35) 起对 targetSdk 35+ 已弃用且不再生效。系统栏透明由
             EdgeToEdge.setup 的官方 enableEdgeToEdge() 统一设置，露出的就是
             根布局的机身底色；这里不再声明任何窗口栏颜色。 -->
    </style>

    <!-- 全 App 统一深色弹窗：暗房面板语义（深底 + 琥珀强调） -->
    <style name="DarkDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">#141416</item>
        <item name="android:colorBackground">#141416</item>
        <item name="colorPrimary">#FFC100</item>
        <item name="colorOnSurface">#E8E4DA</item>
        <item name="colorOnSurfaceVariant">#9A9A9E</item>
        <!-- 列表项文字（setItems 那条列表）走的是独立属性，不设就继承 Material 默认，
             换主题时不会跟着 colorOnSurface 走，必须显式钉住 -->
        <item name="textColorAlertDialogListItem">#E8E4DA</item>
        <item name="android:textColorPrimary">#E8E4DA</item>
        <item name="android:textColorSecondary">#9A9A9E</item>
    </style>

    <!-- 钛银机身下的弹窗：面板跟着机身走，钛面 + 蚀刻深字（真机机身上的字是凹刻的深色） -->
    <style name="TitanDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">#D3CBBD</item>
        <item name="android:colorBackground">#D3CBBD</item>
        <item name="colorPrimary">#8B1A1A</item>
        <item name="colorOnSurface">#2E2B27</item>
        <item name="colorOnSurfaceVariant">#5F5A52</item>
        <item name="textColorAlertDialogListItem">#2E2B27</item>
        <item name="android:textColorPrimary">#2E2B27</item>
        <item name="android:textColorSecondary">#5F5A52</item>
    </style>

    <!-- 成片信息面板：分组标题 -->
    <style name="InfoGroupTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:textColor">#8B1A1A</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- ===== 关于页铭牌：规格行 ===== -->
    <style name="AboutSpecRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="AboutSpecLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8A8A8E</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.11</item>
    </style>

    <style name="AboutSpecValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#E8E4DA</item>
        <item name="android:textSize">10.5sp</item>
    </style>

    <style name="AboutSpecDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#26262A</item>
    </style>

    <!-- 成片信息面板：信息行 -->
    <style name="InfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">#E8D5C8</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
</resources>
