<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <!-- 胶卷选择（整行可点，按胶卷记忆一组冲洗参数） -->
    <LinearLayout
        android:id="@+id/rowDevRoll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="胶卷"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDevRollValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFC100"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 颗粒强度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="颗粒强度"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDevGrainValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.00"
            android:textColor="#FFC100"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sbDevGrain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="200" />

    <!-- 辉光强度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="辉光强度"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDevHalationValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.00"
            android:textColor="#FFC100"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sbDevHalation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="200" />

    <!-- 眩光强度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="眩光强度"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDevGlareValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.00"
            android:textColor="#FFC100"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sbDevGlare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="600" />

    <!-- 放大机曝光 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="放大机曝光"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDevExposureValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.00"
            android:textColor="#FFC100"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sbDevExposure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="150" />

    <!-- 相纸选择（整行可点） -->
    <LinearLayout
        android:id="@+id/rowDevPaper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="相纸选择"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDevPaperValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自动（按胶卷默认）"
            android:textColor="#FFC100"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 恢复默认 -->
    <Button
        android:id="@+id/btnDevReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="恢复默认" />

</LinearLayout>
