<?xml version="1.0" encoding="utf-8"?>
<!-- 慢门子面板：档位 + 触发机制。
     慢门的行为由两件事决定 ——「档位」（关/自然/偏慢）与「触发机制」（概率派/真实派/混合），
     它们是一体的，所以收在同一个面板里，不再把单选组平铺在控制台上。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <!-- 档位（整行可点，就地翻档：关 → 自然 → 偏慢） -->
        <LinearLayout
            android:id="@+id/rowSlowMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/eng_slow_mode"
                android:textColor="#E8E4DA"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSlowModeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/slow_off"
                android:textColor="#FFC100"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />

        <!-- 分组：触发 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hidden_slow_trigger"
            android:textColor="#C0392B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.22" />

        <!-- 慢门三种触发机制：真机没有随机，这里让用户自己决定要多「真」 -->
        <RadioGroup
            android:id="@+id/rgSlowTrigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSlowProb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hidden_slow_prob"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbSlowReal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hidden_slow_real"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbSlowMix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hidden_slow_mix"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/hidden_slow_note"
            android:textColor="#77777C"
            android:textSize="10sp"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>
</ScrollView>
