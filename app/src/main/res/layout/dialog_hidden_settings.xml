<?xml version="1.0" encoding="utf-8"?>
<!--
  工程师模式控制台（关于页版本号连点 10 次解锁；解锁后点一下即可进入）。

  这里是"会影响出片"的开发旋钮：慢门档位、输出风格、冲洗参数，加上原来就在的几个调试项。
  普通使用不该碰到这些，所以从设置面板整块搬过来 —— 设置面板只留日常会改的东西。

  排版沿用设置面板的铭牌写法（item_setting_row：名称 + 说明 + 当前读数），
  切换类控件（开关 / 推子 / 单选）留在下面，因为它们本来就是"调一下看效果"的形态。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/engScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <!-- 工程师模式开关：关掉之后这些旋钮重新藏起来，入口回到"连点 10 次"。
             11-14：开关正下方那行灰字说明按用户要求关掉（控件与中英文文案一并移除）；
             paddingBottom 从 2dp 补到 12dp，避免下方分隔线紧贴开关。 -->
        <Switch
            android:id="@+id/swEngineerMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="6dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:text="@string/eng_mode_title"
            android:textSize="15sp" />

        <!-- 镜头柔度：机身属性，单独一层。放在开关正下方 —— 控制台行多，
             以前排第 6 行，滚动失效时用户根本看不到（11-18 反馈）。 -->
        <include
            android:id="@+id/rowEngLens"
            layout="@layout/item_setting_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />

        <!-- 会影响出片的三项：与设置面板同一套行样式，读数就在右边 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />

        <include
            android:id="@+id/rowEngSlow"
            layout="@layout/item_setting_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />

        <include
            android:id="@+id/rowEngStyle"
            layout="@layout/item_setting_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />

        <!-- 色彩微调：印相档专属（选了店扫整组隐藏，店扫档色彩由店扫签名决定） -->
        <LinearLayout
            android:id="@+id/groupEngColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

                <include
            android:id="@+id/rowEngColor"
            layout="@layout/item_setting_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />
        </LinearLayout>

        <include
            android:id="@+id/rowEngDev"
            layout="@layout/item_setting_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />

        <!-- v50 输入侧反 ISP 归一化：只作用 JPEG / 导入通路，全局一项 -->
        <include
            android:id="@+id/rowEngJpeg"
            layout="@layout/item_setting_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />

        <!-- 腰平取景（折叠屏彩蛋）：设置面板已整行移除，入口只在这里。
             三态 关 / 自动 / 模拟：自动＝只有真实折痕半开才触发；模拟＝直板机调试 -->
        <include
            android:id="@+id/rowEngWaist"
            layout="@layout/item_setting_row" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />

        <!-- A2 造型灯控制（11-18 nRF 抓包破解 FEC7 命令通道 + CRC8-Maxim）：
             外置闪光档连上 A2 后可用；触发链路不受影响（FFF1 Test 帧原样保留） -->
        <LinearLayout
            android:id="@+id/groupEngA2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eng_a2_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvA2Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/eng_a2_not_ready"
                android:textColor="#888"
                android:textSize="12sp" />

            <!-- 官方 App 没有「开关」，造型灯就一根 0–100 滑杆（0 = 关），照抄这个模型：
                 0x05 是进入/退出造型灯模式，不是用户可见的开关，由驱动按滑杆值自动切换 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/eng_a2_brightness"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/sbA2Bright"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvA2Bright"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0%"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/eng_a2_cct"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/sbA2Cct"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvA2Cct"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="50"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- A1 长帧功率（实验）：0 = 1/1，70 = 1/128。用来验证 A2 是否接受官方
                 「组功率」帧族 F0 A1 07 …（11-19 从 godoxflash v1.3.2 逐字节还原） -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/eng_a2_power"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/sbA2Power"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="70" />

                <TextView
                    android:id="@+id/tvA2Power"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="1/1"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnA2Reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#2A2A30"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/eng_a2_reset"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/eng_a2_hint"
                android:textColor="#888"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />

        <!-- v2 暗房编辑流程：11-18 起全量默认开；冲洗只出母片，编辑保存才入相册（只做状态展示） -->
        <include
            android:id="@+id/rowEngDarkroomV2"
            layout="@layout/item_setting_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26262A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp">

            <Switch
                android:id="@+id/swRawNegative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/eng_raw_negative"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/eng_raw_hint"
                android:textColor="#888"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/main_debug_softfocus_prob"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/sbSoftFocusProb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSoftFocusProb"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="40%"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/main_debug_note"
                android:textColor="#888"
                android:textSize="12sp" />

            <!-- 冲洗耗时诊断：慢机上要看一眼才知道时间花在哪（解码 / 引擎 / 落盘），点一下复制 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="@string/hidden_diag_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="monospace"
                android:text="@string/hidden_diag_none"
                android:textSize="10.5sp" />

            <!-- 崩溃日志：相机 HAL / Vulkan 引擎 / LibRaw 都在 native 层，崩了就是整进程闪退，
                 logcat 经常抓不到，只能落盘看。点开可复制或清空。 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/hidden_crash_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCrash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="monospace"
                android:text="@string/hidden_crash_none"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
