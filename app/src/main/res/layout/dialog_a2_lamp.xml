<?xml version="1.0" encoding="utf-8"?>
<!--
  Godox A2 造型灯控制弹层（2026-11-22 从工程控制台迁出，用户拍板：点 LCD 调出）。
  与设置面板 / 拍满弹窗同一套 Relic Cam 机身铭牌语言。
   · 面板底 #1A1A1A，BodyTheme.applyToViewTree 整块翻成钛/黑钛
   · 铭牌头：T3 字标 + 「A2 LAMP」蚀刻码
   · 亮度滑杆 0–100（0 = 关，进面板自动归零保护连拍）+ 色温滑杆 1–100（100 = 白光）
   · 复位按钮（灯只闪 LED 时的自救入口，按官方关灯顺序重放）
  协议：FEC7 命令口 + CRC8-Maxim（11-18 nRF 抓包破解，38/38 帧全中）；
       亮度 = 0x06、色温 = 0x07、模式 = 0x05；🔴 0x0c 永不由 UI 碰（驱动复位序列内部用）。
  交互：入场 Motion.animatePanelIn；「关闭」/点外部/返回键 dismissPanel 退场；
       松手下发（BLE 命令口没有流控，拖动过程逐帧写会堆队列）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:orientation="vertical">

    <!-- 铭牌头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="15dp"
        android:paddingEnd="17dp"
        android:paddingBottom="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivA2LampLogo"
                android:layout_width="82dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:src="@drawable/ic_t3_logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.2"
                android:text="@string/a2_lamp_code"
                android:textColor="#8A8A8E"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvA2LampStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.02"
            android:text="@string/a2_lamp_not_ready"
            android:textColor="#8A8A8E"
            android:textSize="10sp" />

        <!-- 官方 App 没有「开关」，造型灯就一根 0–100 滑杆（0 = 关），照抄这个模型 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.04"
            android:text="@string/a2_lamp_brightness"
            android:textColor="#E8E4DA"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/sbA2Bright"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvA2Bright"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:text="0%"
                android:textColor="#C9C5BC"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.04"
            android:text="@string/a2_lamp_cct"
            android:textColor="#E8E4DA"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/sbA2Cct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvA2Cct"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:text="50"
                android:textColor="#C9C5BC"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.02"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/a2_lamp_hint"
            android:textColor="#8A8A8E"
            android:textSize="10sp" />

        <!-- 功率验证（协议实验）：下发 A1 长帧看 A2 认不认，决定 TTL 落灯还是落相机 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="@string/a2_lamp_pwr_title"
            android:textColor="#C9A882"
            android:textSize="10sp" />

        <!-- 8 档功率滑杆（11-22 人工标定）：index 0..7 → arg 0/10/.../70 → 1/1..1/128 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.04"
            android:text="@string/a2_lamp_pwr_slider"
            android:textColor="#E8E4DA"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/sbA2Power"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="7" />

            <TextView
                android:id="@+id/tvA2Power"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:text="1/8"
                android:textColor="#C9C5BC"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnA2PwrFull"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_nameplate_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/a2_lamp_pwr_full"
                android:textColor="#E8E4DA"
                android:textSize="10.5sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnA2PwrMin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_nameplate_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/a2_lamp_pwr_min"
                android:textColor="#E8E4DA"
                android:textSize="10.5sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnA2PwrRestore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_nameplate_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/a2_lamp_pwr_restore"
                android:textColor="#E8E4DA"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:letterSpacing="0.02"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/a2_lamp_pwr_hint"
            android:textColor="#8A8A8E"
            android:textSize="9.5sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26262A" />

    <!-- 操作行：复位（自救）+ 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingTop="13dp"
        android:paddingEnd="17dp"
        android:paddingBottom="15dp">

        <TextView
            android:id="@+id/btnA2LampReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nameplate_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/a2_lamp_reset"
            android:textColor="#C9C5BC"
            android:textSize="11sp" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tvA2LampClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_choice"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/a2_lamp_close"
            android:textColor="#F0D9C8"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
