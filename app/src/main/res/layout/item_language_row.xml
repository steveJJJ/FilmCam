<?xml version="1.0" encoding="utf-8"?>
<!--
  语言选择铭牌的一行：机身刻字式「序号 / 语言自名 / 规格副标 / 选中刻记」。
  与设置面板 item_setting_row 同一套：等宽小字是刻在金属上的规格，
  语言名是牌面主字，右侧 SET 是落位标记；左侧琥珀竖条只在选中时亮。
  背景由 LanguagePicker 用 GradientDrawable 动态给（选中暖底），
  所以这里的 TextView 都是无底色，主题遍历会按面板色重映射。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp">

    <!-- 选中竖条：规格刻度，落位才亮 -->
    <View
        android:id="@+id/langBar"
        android:layout_width="3dp"
        android:layout_height="26dp"
        android:background="#00FFC100" />

    <!-- 序号：00–05 蚀刻码 -->
    <TextView
        android:id="@+id/langCode"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:textColor="#8A8A8E"
        android:textSize="10.5sp" />

    <!-- 语言自名 + 规格副标 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/langName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.03"
            android:textColor="#E8E4DA"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/langSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:textColor="#8A8A8E"
            android:textSize="8.5sp" />
    </LinearLayout>

    <!-- 落位刻记：选中 SET（琥珀），未选中 ··· -->
    <TextView
        android:id="@+id/langMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.18"
        android:textColor="#FFC100"
        android:textSize="10sp" />
</LinearLayout>
