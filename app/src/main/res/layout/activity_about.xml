<?xml version="1.0" encoding="utf-8"?>
<!--
  关于页：做成机身上的铭牌 / 说明书内页，而不是普通 App 的关于页。
  排版规则（与真机铭牌一致）：
   - 圆角一律 2dp（机加工件没有手机 UI 那种大圆角）
   - 分隔线 0.5~1dp 的细线，是"蚀刻"不是"卡片阴影"
   - 小标题 9sp + 字距 0.2，参数值用等宽字（铭牌上刻的是规格，不是正文）
   - 卡片底色用纯色（#141416），才能跟随机身主题一起翻成钛面；
     边框色 #2E2E2E 刻意留在映射表外 —— 钛银下它就是深色刻线
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- 标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_about_title"
                android:textColor="#E8E4DA"
                android:textSize="15sp"
                android:letterSpacing="0.04" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 问题反馈：点击唤起邮件客户端，自动带上版本与设备信息 -->
            <TextView
                android:id="@+id/tvFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nameplate_chip"
                android:clickable="true"
                android:contentDescription="@string/about_feedback"
                android:drawableStart="@drawable/ic_feedback_mail"
                android:drawableTint="#C9C5BC"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="11dp"
                android:paddingBottom="5dp"
                android:text="@string/about_feedback"
                android:textColor="#C9C5BC"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ===== 机身铭牌：型号 + 规格表 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#2E2E2E"
            android:orientation="vertical"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#141416"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="RELIC CAM" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RELIC CAM"
                            android:textColor="#E8E4DA"
                            android:textSize="17sp"
                            android:letterSpacing="0.22" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/main_about_subtitle"
                            android:textColor="#8A8A8E"
                            android:textSize="9.5sp"
                            android:letterSpacing="0.16" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:background="#26262A" />

                <!-- 型号 -->
                <LinearLayout style="@style/AboutSpecRow">
                    <TextView
                        style="@style/AboutSpecLabel"
                        android:text="@string/about_spec_model" />
                    <TextView
                        style="@style/AboutSpecValue"
                        android:text="@string/about_spec_model_value" />
                </LinearLayout>

                <View style="@style/AboutSpecDivider" />

                <!-- 镜头 -->
                <LinearLayout style="@style/AboutSpecRow">
                    <TextView
                        style="@style/AboutSpecLabel"
                        android:text="@string/about_spec_lens" />
                    <TextView
                        style="@style/AboutSpecValue"
                        android:text="@string/about_spec_lens_value" />
                </LinearLayout>

                <View style="@style/AboutSpecDivider" />

                <!-- 装片 -->
                <LinearLayout style="@style/AboutSpecRow">
                    <TextView
                        style="@style/AboutSpecLabel"
                        android:text="@string/about_spec_film" />
                    <TextView
                        style="@style/AboutSpecValue"
                        android:text="@string/about_spec_film_value" />
                </LinearLayout>

                <View style="@style/AboutSpecDivider" />

                <!-- 引擎 -->
                <LinearLayout style="@style/AboutSpecRow">
                    <TextView
                        style="@style/AboutSpecLabel"
                        android:text="@string/about_spec_engine" />
                    <TextView
                        style="@style/AboutSpecValue"
                        android:text="@string/about_spec_engine_value" />
                </LinearLayout>

                <View style="@style/AboutSpecDivider" />

                <!-- 版本（代码填）：连点 10 次进入工程师模式，不加波纹提示，保持刻字的样子 -->
                <LinearLayout style="@style/AboutSpecRow">
                    <TextView
                        style="@style/AboutSpecLabel"
                        android:text="@string/about_spec_version" />
                    <TextView
                        android:id="@+id/tvSpecVersion"
                        style="@style/AboutSpecValue"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="—" />
                </LinearLayout>

                <View style="@style/AboutSpecDivider" />

                <!-- 工程模式（Pro）：未解锁时点这里买，已解锁时点这里直接进控制台。
                     数值位显示价格/未解锁/PRO 三种状态，由 AboutActivity 渲染。 -->
                <LinearLayout style="@style/AboutSpecRow">
                    <TextView
                        style="@style/AboutSpecLabel"
                        android:text="@string/about_spec_pro" />
                    <TextView
                        android:id="@+id/tvSpecPro"
                        style="@style/AboutSpecValue"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/pro_state_locked" />
                </LinearLayout>

                <View style="@style/AboutSpecDivider" />

                <!-- 检查更新：Play 安装走应用内更新，侧载包跳下载页（零新增权限） -->
                <LinearLayout
                    android:id="@+id/rowCheckUpdate"
                    style="@style/AboutSpecRow"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        style="@style/AboutSpecLabel"
                        android:text="@string/about_spec_update" />
                    <TextView
                        style="@style/AboutSpecValue"
                        android:text="@string/about_update_action" />
                </LinearLayout>

                <View style="@style/AboutSpecDivider" />

                <!-- v82 快速上手重看：重播首次引导的说明书卡（不驱动 onboarding 进度） -->
                <LinearLayout
                    android:id="@+id/rowQuickStart"
                    style="@style/AboutSpecRow"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        style="@style/AboutSpecLabel"
                        android:text="@string/about_spec_quickstart" />
                    <TextView
                        style="@style/AboutSpecValue"
                        android:text="@string/about_quickstart_action" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 机身说明：左侧一条竖线，像说明书里的引文 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <View
                android:layout_width="1.5dp"
                android:layout_height="match_parent"
                android:background="#3A3A40" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:text="@string/about_intro"
                android:textColor="#B8B8BC"
                android:textSize="12.5sp"
                android:lineSpacingMultiplier="1.75" />
        </LinearLayout>

        <!-- ===== 赞赏 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#2E2E2E"
            android:orientation="vertical"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#141416"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="13dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_support"
                    android:textColor="#8A8A8E"
                    android:textSize="9sp"
                    android:letterSpacing="0.2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:src="@drawable/appreciate_code"
                        android:contentDescription="@string/main_cd_tip_code" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_about_tip_title"
                            android:textColor="#E8E4DA"
                            android:textSize="13sp"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/main_about_tip_body"
                            android:textColor="#8A8A8E"
                            android:textSize="10.5sp"
                            android:lineSpacingMultiplier="1.5" />

                        <!-- 海外赞赏：点击打开 PayPal 页面 -->
                        <TextView
                            android:id="@+id/tvPaypal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_nameplate_chip"
                            android:clickable="true"
                            android:contentDescription="@string/main_cd_paypal"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.08"
                            android:paddingStart="12dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="7dp"
                            android:text="@string/about_paypal"
                            android:textColor="#C9C5BC"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 开源致谢 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#2E2E2E"
            android:orientation="vertical"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#141416"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="13dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_credits"
                    android:textColor="#8A8A8E"
                    android:textSize="9sp"
                    android:letterSpacing="0.2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="@string/about_oss_summary"
                    android:textColor="#8A8A8E"
                    android:textSize="10.5sp"
                    android:lineSpacingMultiplier="1.55" />

                <!-- 条目由 strings 的 oss_credits 驱动，代码动态渲染 -->
                <LinearLayout
                    android:id="@+id/ossList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- 本项目自身的许可证（内容由 AboutActivity 动态填充） -->
        <LinearLayout
            android:id="@+id/selfLicenseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- 底部只留许可证一行（版本号已经刻在上方铭牌的 VER 行 —— 点它 10 次进工程师模式） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:gravity="end"
            android:letterSpacing="0.14"
            android:text="GPL-3.0-or-later"
            android:textColor="#6A6A6E"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>
