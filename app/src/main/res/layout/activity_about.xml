<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- 标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关于"
                android:textColor="#E8E4DA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 问题反馈：点击唤起邮件客户端，自动带上版本与设备信息 -->
            <TextView
                android:id="@+id/tvFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feedback_chip"
                android:clickable="true"
                android:contentDescription="问题反馈"
                android:drawableStart="@drawable/ic_feedback_mail"
                android:drawableTint="#C9C5BC"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:paddingStart="11dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="@string/about_feedback"
                android:textColor="#C9C5BC"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="28dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="FILMCAM" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="FILMCAM"
            android:textColor="#E8E4DA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="CONTAX T3 · 数字胶片机"
            android:textColor="#8A8A8E"
            android:textSize="11sp"
            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/about_intro"
            android:textColor="#B8B8BC"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.55" />

        <!-- 赞赏 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="请作者喝杯咖啡"
            android:textColor="#E8E4DA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="感谢支持独立开发 —— 扫码赞赏，或走下方 PayPal"
            android:textColor="#8A8A8E"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/appreciate_code"
            android:contentDescription="赞赏码" />

        <!-- 海外赞赏：点击打开 PayPal 页面 -->
        <TextView
            android:id="@+id/tvPaypal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_feedback_chip"
            android:clickable="true"
            android:contentDescription="PayPal 赞赏"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:paddingStart="18dp"
            android:paddingTop="9dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp"
            android:text="@string/about_paypal"
            android:textColor="#C9C5BC"
            android:textSize="12sp" />

        <!-- 开源致谢：条目由 strings.xml 的 oss_credits 驱动，代码动态渲染 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="开源致谢"
            android:textColor="#E8E4DA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_oss_summary"
            android:textColor="#8A8A8E"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.45" />

        <LinearLayout
            android:id="@+id/ossList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- 本项目自身的许可证（内容由 AboutActivity 动态填充） -->
        <LinearLayout
            android:id="@+id/selfLicenseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />

        <!-- 版本号：连点 10 次进入工程师模式 -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:textColor="#6A6A6E"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:padding="8dp" />
    </LinearLayout>
</ScrollView>
