<?xml version="1.0" encoding="utf-8"?>
<!--
  语言选择铭牌：设置面板「语言」行的二级页（六档一次点选）。
  与机身其他弹窗同一套：T3 字标 + 蚀刻码表头、1dp 蚀刻分隔线、
  「规格刻字（等宽小字）+ 语言自名 + 落位刻记」的铭牌行、底部 pill 关闭键。
  六行由 LanguagePicker 用 item_language_row 动态填充（id 见 langRow*）。
  尺寸/背景在 show() 之前定死（DialogShowJumpTest 契约：零跳变）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:orientation="vertical">

    <!-- 铭牌头：T3 字标 + 蚀刻码 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="15dp"
        android:paddingEnd="17dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivLanguageLogo"
                android:layout_width="82dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:src="@drawable/ic_t3_logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLanguageTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.2"
                android:text="LANGUAGE · 06"
                android:textColor="#8A8A8E"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLanguageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:letterSpacing="0.08"
            android:text="@string/lang_pick_title"
            android:textColor="#E8E4DA"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/tvLanguageSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.02"
            android:text="@string/lang_pick_sub"
            android:textColor="#8A8A8E"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26262A" />

    <!-- 六档铭牌行：语言名 / 规格副标 / 选中刻记 -->
    <LinearLayout
        android:id="@+id/langRowSystem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:background="#202024" />

    <LinearLayout
        android:id="@+id/langRowZh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:background="#202024" />

    <LinearLayout
        android:id="@+id/langRowZhTw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:background="#202024" />

    <LinearLayout
        android:id="@+id/langRowEn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:background="#202024" />

    <LinearLayout
        android:id="@+id/langRowJa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:background="#202024" />

    <LinearLayout
        android:id="@+id/langRowKo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26262A" />

    <!-- 底部 pill：关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingTop="12dp"
        android:paddingEnd="17dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvLanguageClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nameplate_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:paddingStart="18dp"
            android:paddingTop="7dp"
            android:paddingEnd="18dp"
            android:paddingBottom="7dp"
            android:text="@string/set_close"
            android:textColor="#C9C5BC"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
