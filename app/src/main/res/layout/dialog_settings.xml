<?xml version="1.0" encoding="utf-8"?>
<!--
  设置面板：做成机身上的一块铭牌 / 说明书内页，而不是系统 AlertDialog 的条目列表。
  排版规则与关于页（activity_about.xml）同一套：
   · 外框 2~3dp 圆角 + 1px 蚀刻边（机加工面板，不是圆角卡片）
   · 分隔线是 1dp 细线（"蚀刻"不是"卡片阴影"）
   · 面板底用纯色 #1A1A1A —— BodyTheme.applyToViewTree 会把它整块翻成钛面
   · 每行由 item_setting_row.xml 复用（名称/说明由 set_labels / set_hints 两个 array 驱动）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:orientation="vertical">

    <!-- 铭牌头：CONTAX T3 字标 + 关闭；下面一行是标题与英文副题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="14dp"
        android:paddingEnd="15dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivSetLogo"
                android:layout_width="82dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:src="@drawable/ic_t3_logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvSetClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nameplate_chip"
                android:clickable="true"
                android:contentDescription="@string/set_close"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:paddingStart="11dp"
                android:paddingTop="5dp"
                android:paddingEnd="11dp"
                android:paddingBottom="5dp"
                android:text="@string/set_close"
                android:textColor="#C9C5BC"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/set_title"
                android:textColor="#E8E4DA"
                android:textSize="14.5sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:text="@string/set_subtitle"
                android:textColor="#8A8A8E"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26262A" />

    <!-- 六行：横屏可用高度紧张时这里滚动 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/rowSetBody"
                layout="@layout/item_setting_row" />

            <View style="@style/AboutSpecDivider" />

            <include
                android:id="@+id/rowSetDatestamp"
                layout="@layout/item_setting_row" />

            <View style="@style/AboutSpecDivider" />

            <include
                android:id="@+id/rowSetHaptic"
                layout="@layout/item_setting_row" />

            <View style="@style/AboutSpecDivider" />

            <include
                android:id="@+id/rowSetLanguage"
                layout="@layout/item_setting_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="7dp"
                android:background="#26262A" />

            <include
                android:id="@+id/rowSetQuality"
                layout="@layout/item_setting_row" />

            <View style="@style/AboutSpecDivider" />

            <include
                android:id="@+id/rowSetDev"
                layout="@layout/item_setting_row" />

            <View style="@style/AboutSpecDivider" />

            <include
                android:id="@+id/rowSetAbout"
                layout="@layout/item_setting_row" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
