<?xml version="1.0" encoding="utf-8"?>
<!--
  胶卷拍满「去冲洗」引导弹窗：与设置面板 / 放弃修改确认同一套 Relic Cam 机身铭牌语言。
  取代系统 AlertDialog 的纯文字标题 + 消息 + 按钮（用户 11-22 反馈「比较丑」）。
   · 面板底 #1A1A1A，BodyTheme.applyToViewTree 整块翻成钛/黑钛
   · 铭牌头：T3 字标 + 「ROLL FULL」蚀刻码
   · 铭牌主标题「胶卷已拍完」+ 副蚀刻说明
   · 胶卷条进度：36 格小窗全部「曝光」（实心），尾部露出两格未曝光的片基，暗示"该回卷了"
   · 两个 pill 按钮（去冲洗 = 暖色主键 / 稍后 = 铭牌灰键），复用 bg_nameplate_chip / bg_edit_choice
  交互：入场 Motion.animatePanelIn；「稍后」/点外部/返回键走 dismissPanel 退场；
       「去冲洗」是跳转型（立刻进 DevelopmentActivity），按契约保持硬切。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:orientation="vertical">

    <!-- 铭牌头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="15dp"
        android:paddingEnd="17dp"
        android:paddingBottom="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRollFullLogo"
                android:layout_width="82dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:src="@drawable/ic_t3_logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.2"
                android:text="@string/main_roll_finished_code"
                android:textColor="#8A8A8E"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.08"
            android:text="@string/main_roll_finished_title"
            android:textColor="#E8E4DA"
            android:textSize="14.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:letterSpacing="0.02"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/main_roll_finished_body"
            android:textColor="#8A8A8E"
            android:textSize="10sp" />

        <!-- 胶卷条：36 格曝光窗（上排齿孔 + 下排片窗），滚到头 = 该回卷送冲 -->
        <LinearLayout
            android:id="@+id/rollStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- 片基引带（未曝光的空片头）：暖棕片基色 -->
            <View
                android:layout_width="10dp"
                android:layout_height="26dp"
                android:background="#2E2620" />

            <!-- 36 格曝光窗由代码填充（RollFinishedDialogContractTest 锁 36 格） -->
            <LinearLayout
                android:id="@+id/rollStripFrames"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="#141414"
                android:orientation="horizontal" />

            <!-- 片尾引带 -->
            <View
                android:layout_width="10dp"
                android:layout_height="26dp"
                android:background="#2E2620" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26262A" />

    <!-- 两个 pill 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingTop="13dp"
        android:paddingEnd="17dp"
        android:paddingBottom="15dp">

        <TextView
            android:id="@+id/tvRollLater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nameplate_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/main_roll_finished_later"
            android:textColor="#C9C5BC"
            android:textSize="11sp" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tvRollDevelop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_choice"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/main_roll_finished_develop"
            android:textColor="#F0D9C8"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
