<?xml version="1.0" encoding="utf-8"?>
<!--
  首次使用引导 · 段 1「快速上手卡」：机身上的一页说明书，3 屏翻页。
  版式与设置面板 / 反馈弹窗同一套铭牌语言：2dp 圆角外框、1dp 蚀刻线、
  机身字标 + 页码读数。尺寸/背景由 QuickStartCard 在 show() 之前定死
  （DialogShowJumpTest 契约：不得出现「首帧默认宽度再跳变」）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- 铭牌头：字标 + 页码读数（QUICK START · 1/3） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvQuickStartLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="RELIC CAM"
            android:textColor="#E8E4DC"
            android:textSize="13sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvQuickStartPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:textColor="#8A8780"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#3C3C3C" />

    <!-- 本页标题 -->
    <TextView
        android:id="@+id/tvQuickStartTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.02"
        android:textColor="#F9F8F5"
        android:textSize="17sp" />

    <!-- 本页正文（要点用 \n 分行，随文案走） -->
    <TextView
        android:id="@+id/tvQuickStartBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="5dp"
        android:textColor="#B8B4AC"
        android:textSize="12.5sp" />

    <!-- 底部：页点 + 翻页按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvQuickStartDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:textColor="#8A8780"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvQuickStartNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nameplate_chip"
            android:clickable="true"
            android:focusable="true"
            android:letterSpacing="0.08"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textColor="#E8E4DC"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
