<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <!-- 相机预览：全屏（参考 FIMO 真实界面） -->
    <com.filmcam.app.filter.LutGLSurfaceView
        android:id="@+id/glSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 取景网格（已按需求隐藏） -->
    <com.filmcam.app.ui.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 康泰时 T3 取景器常驻标记：四角亮框 + 视差角标 + 中央 AF 圆线 -->
    <com.filmcam.app.ui.ViewfinderFrameView
        android:id="@+id/viewfinderFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ===== 顶部：品牌行 + 功能键行 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp">

        <!-- 行1：品牌 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/brandText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONTAX T3"
                android:textColor="#E8E0D0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
        </LinearLayout>

        <!-- 行2：液晶屏（左） + 功能键（右） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.filmcam.app.ui.T3LcdView
                android:id="@+id/lcdDisplay"
                android:layout_width="172dp"
                android:layout_height="64dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <!-- 闪光灯键：关 → 内置 → 外置 → 关 -->
            <TextView
                android:id="@+id/flashKey"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⚡"
                android:textColor="#2A2A30"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/bg_key"
                android:clickable="true"
                android:focusable="true" />

            <!-- 曝光补偿键：-3 → +3 循环 -->
            <TextView
                android:id="@+id/evKey"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:text="EV0"
                android:textColor="#2A2A30"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_key"
                android:clickable="true"
                android:focusable="true" />

            <!-- 设置键 -->
            <TextView
                android:id="@+id/settingsKey"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:text="⚙"
                android:textColor="#2A2A30"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/bg_key"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <!-- ===== 底部控制条：胶卷图标 / 快门 / 最近预览 ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 左：当前胶卷图标（点击换胶卷） -->
        <ImageView
            android:id="@+id/tvFilmName"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:background="#33000000"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="当前胶卷" />

        <!-- 中：快门 -->
        <View
            android:id="@+id/btnShutter"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_shutter" />

        <!-- 右：最近拍摄预览（进相册） -->
        <ImageView
            android:id="@+id/btnGallery"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="#333"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:contentDescription="相册" />
    </LinearLayout>

    <!-- 隐藏胶卷文字（保留 id，避免破坏逻辑） -->
    <TextView
        android:id="@+id/filmInfoText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- ===== 曝光补偿（隐藏，通过上下滑预览调） ===== -->
    <LinearLayout
        android:id="@+id/layoutExposure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone">
        <TextView android:id="@+id/btnEvMinus" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tvEvValue" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/btnEvPlus" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <!-- 备用/隐藏控件（保留 id 避免破坏 MainActivity） -->
    <TextView
        android:id="@+id/tvFlashStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="闪: 关"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvProToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="专业"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/proControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView android:id="@+id/tvIso" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvShutter" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvExposure" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- ===== 曝光补偿浮层（上下滑动取景器时短暂显示，1.4s 后淡出） ===== -->
    <LinearLayout
        android:id="@+id/evOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="140dp"
        android:alpha="0"
        android:background="@drawable/bg_ev_indicator"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEvIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="EV  0"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/evTicks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 自动过卷动画遮罩（T3 风格：胶卷旋转过卷 + 状态文字） -->
    <FrameLayout
        android:id="@+id/developingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/ivDeveloping"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="fitCenter"
                android:contentDescription="过卷" />
            <TextView
                android:id="@+id/tvDevelopingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="FILM ADVANCING..."
                android:textColor="#FFF"
                android:textSize="13sp"
                android:letterSpacing="0.3" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
