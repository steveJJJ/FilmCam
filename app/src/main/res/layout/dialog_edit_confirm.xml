<?xml version="1.0" encoding="utf-8"?>
<!--
  编辑页「放弃修改」确认弹窗：与设置面板 / 反馈面板同一套 Relic Cam 机身铭牌语言。
  取代系统 AlertDialog 的纯文字标题 + 消息 + 按钮（用户 11-18 反馈「很丑」）。
   · 面板底 #1A1A1A，BodyTheme.applyToViewTree 整块翻成钛/黑钛
   · 铭牌头：T3 字标 + 副蚀刻标题
   · 一行主文案 + 一行副蚀刻说明
   · 两个 pill 按钮（保留修改 / 放弃），复用 bg_nameplate_chip，非系统按钮
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A1A"
    android:orientation="vertical">

    <!-- 铭牌头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="15dp"
        android:paddingEnd="17dp"
        android:paddingBottom="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivEditConfirmLogo"
                android:layout_width="82dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:src="@drawable/ic_t3_logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.2"
                android:text="@string/edit_unsaved_code"
                android:textColor="#8A8A8E"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.08"
            android:text="@string/edit_unsaved_title"
            android:textColor="#E8E4DA"
            android:textSize="14.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:letterSpacing="0.02"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/edit_unsaved_msg"
            android:textColor="#8A8A8E"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26262A" />

    <!-- 两个 pill 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingTop="13dp"
        android:paddingEnd="17dp"
        android:paddingBottom="15dp">

        <TextView
            android:id="@+id/tvEditKeep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nameplate_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/edit_keep"
            android:textColor="#C9C5BC"
            android:textSize="11sp" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tvEditDiscard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_choice"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/edit_discard"
            android:textColor="#F0D9C8"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
