<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 外接蓝牙闪光灯（FotorGear）。
         API 31+：BLUETOOTH_SCAN 声明 neverForLocation，无需位置权限。
         API 26-30：BLE 扫描仍依赖位置权限，故用 maxSdkVersion=30 收窄，避免高版本被要求填写位置用途。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- 仅 API 26-28 直接写公共 DCIM 目录时需要；API 29+ 全程走 MediaStore，无需存储权限。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 暗房冲洗：前台服务 + 通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 内购（工程模式 Pro）。购买请求经 IPC 交给 Play 商店，真正的联网由 Play 商店完成，
         所以本 App 依旧不申请 INTERNET 权限 —— 这是隐私政策的核心论据，别加回来。

         但 billing 的传递依赖（play-services-location、Firebase datatransport）会在清单合并时
         注入 INTERNET / ACCESS_NETWORK_STATE / ACCESS_COARSE_LOCATION，下面逐个剔掉。
         注意 ACCESS_FINE_LOCATION 不能 remove：我们自己要在 API≤30 上用它扫 BLE，
         它与库里的同名声明会自动合并，保留 maxSdkVersion=30 的收窄。 -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />

    <!-- allowBackup 必须关闭：未冲洗胶卷的登记表在 SharedPreferences（会被备份），
         而对应的帧文件在 MediaStore / DCIM（不在同一备份域，不会恢复）。
         开启备份会导致换机恢复后"登记表有 12 帧、实际文件 0 个"，整卷冲洗失败。

         largeHeap：冲洗一帧需要 12MP ARGB 位图（48MB）+ 引擎 float 缓冲（143MB），
         标准堆上限在多数机型为 192-256MB，必 OOM。图像处理类 App 的标准做法。 -->
    <application
        android:name=".FilmCamApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:resizeableActivity="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FilmCam">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor" />

        <!-- 启动图标：Relic Cam 银色相机图（11-07 用户指定，白底方形、已去水印），单一静态入口。
             保留 .LauncherBlack 这个组件名只为兼容：v24/v25 已放上桌面的快捷方式
             指向它，改名字会让图标直接失效——名字是历史遗留，与图标颜色无关。
             动态切换/钛银别名已撤掉（setComponentEnabledSetting 后三星桌面不重建
             图标，真机上表现为「图标没变」）。不声明 roundIcon / adaptive icon：
             让完整实拍图交给 Launcher 裁形状，避免 66% 安全区把相机四角切掉。
             application:icon 与 alias:icon 指向同一张图，桌面与应用信息一致。 -->
        <activity-alias
            android:name=".LauncherBlack"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- 取景器之外一律跟随传感器：折叠屏（Mate X5）展开后本来就是横向视界，
             锁死竖屏会让人横着拿手机、看一个竖着的页面。相册的网格列数按宽度算，
             横屏会自动排得更宽（见 GalleryActivity 的 spanCount）。 -->
        <activity
            android:name=".GalleryActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".PhotoViewerActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <!-- 暗房冲洗 -->
        <activity
            android:name=".develop.DevelopmentActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <service
            android:name=".develop.DevelopmentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- AndroidX 多语言：由框架托管 App 语言（API 33+ 交给系统 LocaleManager，
             低版本存在 AppCompat 自己的存储里），enable=false 是因为它只作为元数据持有者 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
