<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 外接蓝牙闪光灯（FotorGear）。
         API 31+：BLUETOOTH_SCAN 声明 neverForLocation，无需位置权限。
         API 26-30：BLE 扫描仍依赖位置权限，故用 maxSdkVersion=30 收窄，避免高版本被要求填写位置用途。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- 仅 API 26-28 直接写公共 DCIM 目录时需要；API 29+ 全程走 MediaStore，无需存储权限。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 暗房冲洗：前台服务 + 通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup 必须关闭：未冲洗胶卷的登记表在 SharedPreferences（会被备份），
         而对应的帧文件在 MediaStore / DCIM（不在同一备份域，不会恢复）。
         开启备份会导致换机恢复后"登记表有 12 帧、实际文件 0 个"，整卷冲洗失败。

         largeHeap：冲洗一帧需要 12MP ARGB 位图（48MB）+ 引擎 float 缓冲（143MB），
         标准堆上限在多数机型为 192-256MB，必 OOM。图像处理类 App 的标准做法。 -->
    <application
        android:name=".FilmCamApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:resizeableActivity="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FilmCam">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GalleryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PhotoViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 暗房冲洗 -->
        <activity
            android:name=".develop.DevelopmentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <service
            android:name=".develop.DevelopmentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- AndroidX 多语言：由框架托管 App 语言（API 33+ 交给系统 LocaleManager，
             低版本存在 AppCompat 自己的存储里），enable=false 是因为它只作为元数据持有者 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
